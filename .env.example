# Development and Node production proxy. Never prefix server secrets with VITE_.
API_PROXY_TARGET=http://localhost:8080
# Leave empty for the same-origin /api proxy (recommended).
VITE_API_BASE_URL=
# Optional customer city choices. IDs MUST match cities in your database.
VITE_CITY_OPTIONS=[]
# LocalDateTime responses are interpreted in this cinema timezone.
VITE_CINEMA_TIMEZONE=Asia/Kolkata
VITE_CURRENCY=INR
VITE_ENABLE_DEMO=true
